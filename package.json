{
  "name": "seahivez-theme",
  "version": "1.0.0",
  "description": "Custom premium yacht charter WordPress theme for SeaHivez Mallorca.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev:css": "tailwindcss -i ./assets/css/src/main.css -o ./assets/dist/main.css --watch",
    "dev:js": "esbuild assets/js/src/main.js --bundle --outfile=assets/dist/main.js --watch",
    "dev": "npm-run-all --parallel dev:css dev:js",
    "build:css": "tailwindcss -i ./assets/css/src/main.css -o ./assets/dist/main.css --minify",
    "build:js": "esbuild assets/js/src/main.js --bundle --outfile=assets/dist/main.js --minify",
    "build": "npm-run-all build:css build:js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.14",
    "swiper": "^14.1.0"
  }
}
